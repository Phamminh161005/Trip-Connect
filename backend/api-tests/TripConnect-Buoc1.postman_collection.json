    {
      "name": "0. Đăng nhập",
      "item": [
        {
          "name": "Login Agent (tự lưu token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự lưu token vào Environment đang chọn (không cần copy-paste)",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"agentToken\", body.accessToken);",
                  "    pm.environment.set(\"agentRefreshToken\", body.refreshToken);",
                  "    console.log(\"Đã lưu token Agent vào Environment\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin (tự lưu token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự lưu token vào Environment đang chọn (không cần copy-paste)",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"adminToken\", body.accessToken);",
                  "    pm.environment.set(\"adminRefreshToken\", body.refreshToken);",
                  "    console.log(\"Đã lưu token Admin vào Environment\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Agent (khi gặp 401 thì bấm Send ở đây)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự lưu token vào Environment đang chọn (không cần copy-paste)",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"agentToken\", body.accessToken);",
                  "    pm.environment.set(\"agentRefreshToken\", body.refreshToken);",
                  "    console.log(\"Đã lưu token Agent vào Environment\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{agentRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Admin (khi gặp 401 thì bấm Send ở đây)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự lưu token vào Environment đang chọn (không cần copy-paste)",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"adminToken\", body.accessToken);",
                  "    pm.environment.set(\"adminRefreshToken\", body.refreshToken);",
                  "    console.log(\"Đã lưu token Admin vào Environment\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "response": []
        }
      ]
